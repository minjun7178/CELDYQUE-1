    <section class="faq-section" id="hair-section"><h2>Scalp Care</h2><div class="faq-list">
      <details class="faq-item" data-cat="hair" id="question-15">
        <summary class="faq-header"><span class="faq-category">Scalp Care</span><span class="faq-question">What is 9-Peptide Scalp Care Serum Roll-On?</span><span class="faq-toggle" aria-hidden="true">+</span></summary>
