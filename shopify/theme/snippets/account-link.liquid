{% if shop.customer_accounts_enabled %}
  <a class="pilot-account-link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" rel="nofollow" aria-label="{% if customer %}My account and orders{% else %}Sign in or create an account{% endif %}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>
    <span>{% if customer %}Account{% else %}Sign in{% endif %}</span>
  </a>
{% endif %}
