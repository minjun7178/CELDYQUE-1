<script>
    document.addEventListener("DOMContentLoaded", () => {
      const slides = [
        { title: "We aim to find and provide ingredients with proven efficacy through research and clinical studies.",
          desc: "새로운 연구자료와 논문 등을 통해 입증된 효능 원료를 찾아 제공하고자 합니다.",
          img: "{{ 'media-d40dea4632-10.webp' | asset_url }}",
          fallback: "{{ 'media-5885a472c3-10.jpg' | asset_url }}"
        },
        { title: "Maximum efficacy while providing comfortable use from the customer's perspective.",
          desc: "최고의 효능을 유지하는 동시에 고객의 입장에서 편안한 사용감을 제공합니다.",
          img: "{{ 'media-cdd7664694-7.webp' | asset_url }}",
          fallback: "{{ 'media-4c84ab47c5-7.jpg' | asset_url }}"
        },
        { title: "We do not develop products recklessly to expand meaningless product lines.",
          desc: "의미없는 제품라인의 확장을 위해 무분별한 제품을 개발하지 않습니다.",
          img: "{{ 'media-cb4a0b43da-15.webp' | asset_url }}",
          fallback: "{{ 'media-19aaff1482-15.jpg' | asset_url }}"
        },
        { title: "Find yourself regaining confidence with visibly transformed skin.",
          desc: "눈에 보이는 변화를 통해 자신감을 되찾은 나를 발견할 수 있습니다.",
          img: "{{ 'media-dff68318ab-14.webp' | asset_url }}",
          fallback: "{{ 'media-347d55af63-14.jpg' | asset_url }}"
        }
      ];

      document.querySelectorAll('.philosophy-nav button').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.dataset.slide, 10);
          document.querySelectorAll('.philosophy-nav button').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const content = document.getElementById('philosophyContent');
          const img = document.getElementById('philosophyImage');

          content.innerHTML = `<h3>${slides[idx].title}</h3><p>${slides[idx].desc}</p><a href="{{ pages['about'].url }}">Read more</a>`;
          img.closest('picture').querySelector('source').srcset = slides[idx].img;
          img.src = slides[idx].fallback;
        });
      });
    });
  </script>
