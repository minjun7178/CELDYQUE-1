<main id="MainContent" class="container pilot-cart"><h1 class="serif">Search</h1><form action="{{ routes.search_url }}" method="get"><label>Search products<input type="search" name="q" value="{{ search.terms | escape }}"></label><input type="hidden" name="type" value="product"><button class="btn-buy" type="submit">Search</button></form>{% for item in search.results %}<p><a href="{{ item.url }}">{{ item.title | escape }}</a></p>{% else %}<p>No matching products. This preview contains ArbutXA Glow Cream only.</p>{% endfor %}</main>
