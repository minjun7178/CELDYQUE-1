  "observed_copy": {
    "original_description": "CELDYQUE Blue Copper Peptide Bakuchiol Serum pairs Copper Tripeptide-1, Bakuchiol, Matrixyl 3000, Argireline, EGF, Niacinamide and Hyaluronic Acid for lightweight firming, plumping, smoothing and hydration care.",
    "original_ingredient_text": "Key Ingredients Peptides · Hydration · Daily Firming Care Fragrance-FreeLightweightFast-AbsorbingNon-Greasy Peptide Complex: Copper Tripeptide-1 (GHK-Cu), Matrixyl 3000, Argireline / Acetyl Hexapeptide-8, EGF / sh-Oligopeptide-1, Palmitoyl Tripeptide-1, Palmitoyl Tetrapeptide-7 and additional peptides in the 12-Peptide Complex. Firming & Radiance Care: Bakuchiol, Niacinamide 2%, Adenosine, Tocopherol and Guaiazulene. Hydration Support: Hydrolyzed Hyaluronic Acid, Hydrolyzed Collagen, Beta-Glucan, Panthenol, Allantoin and Betaine. Refer to the product packaging for the complete and most current ingredient list. For external use only. Avoid direct contact with the eyes. Perform a patch test before first use. Discontinue use if persistent irritation occurs. Keep out of reach of children.",
    "original_faq": [
      {
        "@type": "Question",
        "name": "What is Blue Copper Peptide Bakuchiol Serum used for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It is a daily Korean face serum designed for the appearance of plumper, firmer, smoother and more hydrated-looking skin."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use it morning and night?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. It is designed for AM and PM routines. Use sunscreen as the final step in the morning."
        }
      },
      {
        "@type": "Question",
        "name": "Is it fragrance-free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The formula is positioned as fragrance-free, lightweight and fast-absorbing."
